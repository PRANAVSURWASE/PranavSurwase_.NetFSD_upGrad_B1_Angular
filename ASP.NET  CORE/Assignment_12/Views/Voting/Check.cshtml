
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Check</title>
</head>
<body>
    @{
            ViewData["Title"] = "Voting Eligibility";
            int age = Convert.ToInt32(ViewData["Age"]);
        }

       <h2>@ViewData["Title"]<h2/>
       <p>Age :@age</p>

       @if(age>=18)
            {
            <p style="color:green;">Eligible to vote</p>
            }
            else
            {
            <p style="color:firebrick;">Not Eligible to vote</p>
            }
    </body>
</html>
