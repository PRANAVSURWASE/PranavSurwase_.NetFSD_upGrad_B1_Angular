@model Assignment_3.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto text-center" style="max-width: 500px;">
        
        <h3 class="mb-4">My Profile</h3>

        <div class="mb-3">
            <h5 class="text-muted">Name</h5>
            <p class="fs-5">@Model.Name</p>
        </div>

        <div class="mb-4">
            <h5 class="text-muted">Email</h5>
            <p class="fs-5">@Model.Email</p>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
            <a asp-action="Logout" class="btn btn-danger">Logout</a>
        </div>

    </div>
</div>