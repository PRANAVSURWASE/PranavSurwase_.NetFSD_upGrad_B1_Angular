@model Assignment_5.Models.Student
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create Studnet</h1>


    <form asp-action="Create">
    <table class="table">
        <tr>
            <td>Name:</td>
            <td><input  asp-for="Name"/></td>
        </tr>

        <tr>
            <td>Age:</td>
            <td><input asp-for="Age" /></td>
        </tr>

        <tr>
            <td>Email:</td>
            <td><input asp-for="Email" /></td>
        </tr>

        <tr>
            <td colspan="2">
                <button type="submit">Save</button>
            </td>
        </tr>
    </table>
        
    </form>





