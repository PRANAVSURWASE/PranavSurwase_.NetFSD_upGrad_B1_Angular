
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>List</title>
</head>
<body>
  
    @{
            ViewData["Title"] = "Student List";
            var students = ViewData["students"] as List<string>;

        }
    <h2>@ViewData["Title"]<h2/>
        @foreach(var student in students)
            {
                <p>@student</p>
            }
    </body>
</html>
